{
  "name": "@newcode-team/env",
  "version": "0.1.2",
  "description": "Per-environment env files for any command, with switching and guards",
  "type": "module",
  "sideEffects": false,
  "license": "MIT",
  "author": "NewCode",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NewCodeDevelopment/tools.git",
    "directory": "packages/env"
  },
  "homepage": "https://github.com/NewCodeDevelopment/tools/tree/main/packages/env#readme",
  "bugs": "https://github.com/NewCodeDevelopment/tools/issues",
  "keywords": [
    "env",
    "dotenv",
    "environment",
    "cli"
  ],
  "bin": {
    "newenv": "./dist/cli.mjs"
  },
  "scripts": {
    "dev": "tsdown --config tsdown.config.ts --config-loader unrun --watch --no-clean",
    "build": "tsdown --config tsdown.config.ts --config-loader unrun --no-clean",
    "build:release": "tsdown --config tsdown.config.ts --config-loader unrun",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:ci": "vitest run",
    "clean": "rm -rf .turbo && rm -rf node_modules && rm -rf dist"
  },
  "dependencies": {
    "@inquirer/confirm": "^6.4.0",
    "@inquirer/input": "^5.2.0",
    "commander": "^15.1.0",
    "cross-spawn": "^7.0.6",
    "dotenv": "^17.4.2",
    "dotenv-expand": "^12.0.3"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "catalog:",
    "@types/cross-spawn": "^6.0.6",
    "@types/node": "catalog:",
    "dotenv-cli": "11.0.0",
    "publint": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "unrun": "catalog:",
    "vitest": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=24"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  }
}
