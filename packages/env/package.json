{
  "name": "@newcode-team/env",
  "version": "0.1.0",
  "description": "Per-environment env files for any command, with switching and guards",
  "type": "module",
  "sideEffects": false,
  "license": "MIT",
  "bin": {
    "newenv": "./dist/cli.mjs"
  },
  "scripts": {
    "dev": "tsdown --config tsdown.config.ts --config-loader unrun --watch --no-clean",
    "build": "tsdown --config tsdown.config.ts --config-loader unrun --no-clean",
    "build:release": "tsdown --config tsdown.config.ts --config-loader unrun",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:ci": "vitest run",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm build:release && changeset publish",
    "clean": "rm -rf node_modules && rm -rf dist"
  },
  "dependencies": {
    "@inquirer/confirm": "^6.4.0",
    "@inquirer/input": "^5.2.0",
    "commander": "^15.1.0",
    "cross-spawn": "^7.0.6",
    "dotenv": "^17.4.2",
    "dotenv-expand": "^12.0.3"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "^0.18.5",
    "@changesets/cli": "^3.0.3",
    "@types/cross-spawn": "^6.0.6",
    "@types/node": "^24.19.2",
    "dotenv-cli": "11.0.0",
    "oxfmt": "0.78.0",
    "oxlint": "1.93.0",
    "publint": "^0.3.25",
    "tsdown": "^0.23.7",
    "typescript": "5.9.3",
    "unrun": "^0.3.1",
    "vitest": "^5.1.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": "24.x"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.27.0"
    },
    "runtime": {
      "name": "node",
      "version": "^24.x",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@11.27.0"
}
