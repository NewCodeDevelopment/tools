{
  "name": "newcode-tools",
  "type": "module",
  "private": true,
  "license": "MIT",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "test": "turbo run test",
    "test:ci": "turbo run test:ci",
    "lint": "turbo run lint --",
    "lint:fix": "turbo run lint:fix --",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean && rm -rf node_modules",
    "format": "turbo run format --",
    "format:check": "turbo run format:check --",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "turbo run build:release --filter='./packages/*' && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "oxfmt": "0.78.0",
    "oxlint": "1.93.0",
    "turbo": "^2.11.2",
    "typescript": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.27.0"
    },
    "runtime": {
      "name": "node",
      "version": "^24.x",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@11.27.0"
}
