{
  "$schema": "https://turbo.build/schema.json",
  "extends": ["//"],
  "tasks": {
    "build": {
      "inputs": ["$TURBO_DEFAULT$", ".envs/**"],
      "outputs": [".next/**", "!.next/cache/**"]
    },
    "typecheck": {
      "outputs": ["tsconfig.tsbuildinfo", ".next/types/**", ".next/dev/types/**"]
    }
  }
}
