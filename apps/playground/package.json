{
  "name": "@newcode-team/playground",
  "version": "0.0.0",
  "private": true,
  "description": "Next.js app to try the NewCode tools as an installed dependency",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "newenv next dev",
    "build": "newenv next build",
    "start": "newenv next start",
    "env:use": "newenv use",
    "env:status": "newenv status",
    "env:init": "newenv init",
    "env:script": "node scripts/env.ts",
    "db:push": "newenv node scripts/db-push.ts",
    "db:sync": "newsync db",
    "s3:sync": "newsync s3",
    "sync:script": "node scripts/sync.ts",
    "services:start": "docker compose up -d --wait && docker compose wait storage-init",
    "services:stop": "docker compose stop",
    "services:reset": "docker compose down -v && pnpm services:start",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "typecheck": "next typegen && tsc --noEmit",
    "clean": "rm -rf .turbo && rm -rf node_modules && rm -rf .next"
  },
  "dependencies": {
    "next": "16.3.5",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@newcode-team/config": "workspace:*",
    "@newcode-team/env": "workspace:*",
    "@newcode-team/sync": "workspace:*",
    "@types/node": "catalog:",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "catalog:"
  },
  "engines": {
    "node": ">=24"
  }
}
